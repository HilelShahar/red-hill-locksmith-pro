# Create a free Resend account at https://resend.com and paste the API key here.
# Copy this file to .env.local for local development (never commit the key).
RESEND_API_KEY=

# Optional. Until you verify redhillsecuritylocksmith.com.au in Resend, leave this
# as the onboarding address. After domain verification, switch to something like:
# ENQUIRY_FROM_EMAIL="Red Hill Security <info@redhillsecuritylocksmith.com.au>"
ENQUIRY_FROM_EMAIL="Red Hill Security <onboarding@resend.dev>"

# Optional. Defaults to info@redhillsecuritylocksmith.com.au
# ENQUIRY_TO_EMAIL=info@redhillsecuritylocksmith.com.au
